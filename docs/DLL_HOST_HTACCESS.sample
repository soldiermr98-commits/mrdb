# ===========================================================================
# مستر دستباف — حفاظت Hotlink برای dll.mrdastbaaf.com
# ---------------------------------------------------------------------------
# هاست: cPanel 138 + Apache 2.4.67 + BitNinja WAF
# اگه روی هاست اشتراکی هستید، این فایل را در ریشهٔ dll.mrdastbaaf.com
# (کنار پوشهٔ FA/) به‌عنوان .htaccess قرار دهید.
#
# هدف: جلوگیری از اشتراک‌گذاری URL ویدیوها. URL ویدیو فقط وقتی سرو
# می‌شود که از داخل اپ مستر دستباف (app.mrdastbaaf.com) درخواست شده باشد.
# اگه کسی URL را در آدرس‌بار بچسباند یا در تلگرام/اینستاگرام منتشر کند،
# به جای ویدیو، خطای 403 می‌بیند.
# ===========================================================================

# ---------------------------------------------------------------------------
# ۱) فعال‌سازی ماژول‌های مورد نیاز — Apache 2.4
# ---------------------------------------------------------------------------
<IfModule mod_setenvif.c>

  # ─── دامنه‌های مجاز (Referer درست) ──────────────────────────────────────
  # فقط درخواست‌هایی که از این دامنه‌ها آمده‌اند، ویدیو می‌بینند.
  # الگو: هم mrdastbaaf.com، هم www.mrdastbaaf.com و هم زیردامنه‌ها
  SetEnvIf Referer "^https?://([a-z0-9-]+\.)?mrdastbaaf\.com/" ALLOWED_HOTLINK=1
  # از خود dll.mrdastbaaf.com هم اجازه بده (برای تست‌های هم‌سرور)
  SetEnvIf Referer "^https?://([a-z0-9-]+\.)?dll\.mrdastbaaf\.com/" ALLOWED_HOTLINK=1

  # ─── درخواست‌های بدون Referer ───────────────────────────────────────────
  # درخواست‌های بدون Referer (مثلاً آدرس‌بار، bookmark، بعضی مرورگرهای موبایل)
  # را مجاز می‌کنیم. دلیل: برخی کاربران قانونی با privacy browser مراجعه
  # می‌کنند و Referer نمی‌فرستند. اگه بخواهید سخت‌گیرانه‌تر باشد، این خط را
  # کامنت کنید (ولی ریسک مسدود شدن کاربران قانونی را بپذیرید).
  SetEnvIf Referer "^$" ALLOWED_HOTLINK=1

  # ─── موتورهای جستجوی مجاز (SEO) ─────────────────────────────────────────
  # اختیاری: اگه می‌خواهید Google/Bing/Yandex ویدیوها را ایندکس کنند.
  # اگه نمی‌خواهید، این سه خط را کامنت کنید.
  SetEnvIf Referer "google" ALLOWED_HOTLINK=1
  SetEnvIf Referer "bing" ALLOWED_HOTLINK=1
  SetEnvIf Referer "yandex" ALLOWED_HOTLINK=1

  # ---------------------------------------------------------------------------
  # ۲) کنترل دسترسی — Apache 2.4 syntax (mod_authz_host)
  # ---------------------------------------------------------------------------
  # نکتهٔ حیاتی: در Apache 2.4 از "Require env" استفاده می‌شود، نه
  # "Order/Allow" قدیمی. فایل قدیمی که "Order Deny,Allow" داشت روی 2.4
  # ممکن است باعث خطای 500 شود.
  <FilesMatch "\.(mp4|webm|ogg|mov|m4v|m3u8|ts)$">
    <IfModule mod_authz_host.c>
      # فقط اگر ALLOWED_HOTLINK=1 ست شده باشد، اجازه بده
      Require env ALLOWED_HOTLINK
    </IfModule>
  </FilesMatch>

</IfModule>

# ---------------------------------------------------------------------------
# ۳) هدرهای امنیتی اضافی (اختیاری)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Cross-Origin — فقط برای دامنه‌های مستر دستباف
  SetEnvIf Origin "^https?://([a-z0-9-]+\.)?mrdastbaaf\.com$" CORS_ALLOWED=1
  Header always set Access-Control-Allow-Origin "*" env=CORS_ALLOWED

  # nosniff — جلوگیری از نوع‌فریب کردن MIME
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# ---------------------------------------------------------------------------
# ۴) MIME type صحیح برای فایل‌های ویدیویی
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType video/mp4 .mp4 .m4v
  AddType video/webm .webm
  AddType video/ogg .ogg
  AddType application/vnd.apple.mpegurl .m3u8
  AddType video/mp2t .ts
</IfModule>

# ---------------------------------------------------------------------------
# ۵) کش — فایل‌های ویدیویی cache-busting ندارند، پس revalidate
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webm|ogg|mov|m4v)$">
    Header set Cache-Control "private, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# ۶) جلوگیری از نمایش فایل‌های مخفی (شامل خود .htaccess)
# ---------------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
