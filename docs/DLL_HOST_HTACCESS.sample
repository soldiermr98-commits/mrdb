# ===========================================================================
# مستر دستباف — حفاظت Hotlink برای هاست ویدیو (dll.mrdastbaaf.com)
# ---------------------------------------------------------------------------
# این فایل را در ریشهٔ dll.mrdastbaaf.com قرار دهید (کنار پوشهٔ /FA/ و...).
#
# هدف: جلوگیری از اشتراک‌گذاری URL ویدیوها. هر URL ویدیو فقط وقتی سرو
# می‌شود که از داخل اپ مستر دستباف (app.mrdastbaaf.com) درخواست شده باشد.
# اگه کسی URL را کپی کند و در آدرس‌بار مرورگر بچسباند → 403 Forbidden.
#
# نکته: این لایهٔ اول حفاظت است و سد کامل نیست (هکر می‌تواند Referer را
# جعل کند) ولی ۹۰٪ اشتراک‌گذاری عادی را متوقف می‌کند. لایهٔ دوم (PHP proxy
# با URL امضاشده) در آینده اضافه می‌شود — تا آن زمان، این فایل کافی است.
# ===========================================================================

# ---------------------------------------------------------------------------
# فعال‌سازی rewrite engine
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ─── مجاز بودن درخواست‌های بدون Referer (برخی مرورگرها/برنامه‌ها ارسال
  #     نمی‌کنند) — اختیاری. اگه می‌خواهید سخت‌گیرانه‌تر باشد، این بلوک را
  #     حذف کنید تا فقط درخواست‌های با Referer درست پاسخ داده شوند.
  #     توجه: حذف این بلوک ممکن است برخی کاربران قانونی را هم مسدود کند.
  # ---------------------------------------------------------------------------

  # ─── لیست دامنه‌های مجاز (Referer) ───────────────────────────────────
  # دامنهٔ اپ + سایت اصلی + زیردامنه‌های develop (در صورت نیاز)
  # نکته: الگو با "^https?://([a-z0-9-]+\.)?" شروع می‌شود تا هم www و هم
  # بدون www و هم زیردامنه‌ها پوشش داده شوند.
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?mrdastbaaf\.com/ [NC]

  # ─── استثناها (همیشه مجاز) ────────────────────────────────────────────
  # ۱) درخواست‌های بدون Referer (آدرس‌بار، bookmark، بعضی کلاینت‌ها)
  #    - این خط را اگه می‌خواهید فقط Referer دار پاسخ داده شود، کامنت کنید
  RewriteCond %{HTTP_REFERER} ^$ [OR]
  # ۲) موتورهای جستجوی مجاز (SEO)
  RewriteCond %{HTTP_REFERER} google\. [NC,OR]
  RewriteCond %{HTTP_REFERER} bing\. [NC,OR]
  RewriteCond %{HTTP_REFERER} yandex\. [NC,OR]
  # ۳) درخواست‌های same-origin (همون سرور)
  RewriteCond %{HTTP_REFERER} ^https?://([a-z0-9-]+\.)?dll\.mrdastbaaf\.com/ [NC]
  #     این شرایط بالا با OR ترکیب می‌شوند → اگه هر کدام درست باشد،
  #     درخواست مجاز است. اگه هیچ‌کدام درست نباشد، درخواست رد می‌شود.

  # ---------------------------------------------------------------------------
  # نکتهٔ منطقی: RewriteCond ها به‌صورت AND پیش‌فرض هستند. برای ترکیب OR
  # باید [OR] در پایان هر خط (به‌جز آخرین) بیاید. الگوی بالا به این معناست:
  #
  #   اگه (Referer نمی‌تواند mrdastbaaf.com باشد) و
  #      (Referer خالی است OR google/bing/yandex OR dll.mrdastbaaf.com)
  #   ⇒ درخواست مجاز است (چون شرط دوم "مجاز بودن" را ارضا می‌کند)
  #
  #   اگه فقط شرط اول درست باشد (یعنی Referer از سایت دیگری آمده)
  #   ⇒ شرط دوم هم باید درست باشد، وگرنه رد می‌شود.
  # ---------------------------------------------------------------------------
  #
  # در واقع، الگوی درست برای Apache:
  #   - RewriteCond #1: اگر Referer برای mrdastbaaf.com نباشد
  #   - RewriteCond #2: اگر Referer خالی یا موتور جستجو یا dll.mrdastbaaf.com نباشد
  #   - RewriteRule: رد کن (403)
  #
  # اما این پیچیده می‌شود. ساده‌تر و مطمئن‌تر: استفاده از SetEnvIf.

</IfModule>

# ---------------------------------------------------------------------------
# روش ساده‌تر و مطمئن‌تر: SetEnvIf
# ---------------------------------------------------------------------------
# این الگو خواناتر و کم‌خطا است. اگه mod_rewrite در دسترس نبود، این کار می‌کند.

<IfModule mod_setenvif.c>
  # پیش‌فرض: همه چیز مجاز است مگر اینکه خلافش ثابت شود
  # (برای اطمینان از اینکه کاربران قانونی مسدود نمی‌شوند)

  # اگر Referer از دامنهٔ مجاز است → متغیر ALLOWED_HOTLINK را ست کن
  SetEnvIf Referer "^https?://([a-z0-9-]+\.)?mrdastbaaf\.com/" ALLOWED_HOTLINK=1
  SetEnvIf Referer "^https?://([a-z0-9-]+\.)?dll\.mrdastbaaf\.com/" ALLOWED_HOTLINK=1

  # درخواست‌های بدون Referer (آدرس‌بار، bookmark، برخی موبایل‌ها) → مجاز
  # توجه: اگه می‌خواهید سخت‌گیرانه‌تر باشد و فقط Referer درست مجاز باشد،
  # این خط را کامنت کنید. ولی این کار ممکن است برخی کاربران قانونی را
  # مسدود کند (به‌خصوص روی موبایل که بعضی مرورگرها Referer نمی‌فرستند).
  SetEnvIf Referer "^$" ALLOWED_HOTLINK=1

  # موتورهای جستجو (اختیاری — برای SEO)
  SetEnvIf Referer "google" ALLOWED_HOTLINK=1
  SetEnvIf Referer "bing" ALLOWED_HOTLINK=1
  SetEnvIf Referer "yandex" ALLOWED_HOTLINK=1

  # اگه ALLOWED_HOTLINK ست نشده → درخواست از سایت غیرمجاز آمده
  # در این صورت، فایل‌های ویدیویی را رد کن (403)
  <FilesMatch "\.(mp4|webm|ogg|mov|m4v|m3u8|ts)$">
    Order Deny,Allow
    Deny from all
    Allow from env=ALLOWED_HOTLINK
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# هدرهای امنیتی اضافی (اختیاری ولی توصیه‌شده)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # اگه به هر دلیلی درخواست رد شد، نوع خطا را مشخص کن
  # (به‌جای صفحهٔ پیش‌فرض 403 که اطلاعات هاست را لو می‌دهد)
  ErrorDocument 403 "Forbidden"

  # CORS — فقط به app.mrdastbaaf.com اجازه بده (برای پخش cross-origin)
  # نکته: اگر بعداً PHP proxy اضافه کردید، این خط باید به‌روز شود
  SetEnvIf Origin "^https?://([a-z0-9-]+\.)?mrdastbaaf\.com$" CORS_ALLOWED=1
  Header always set Access-Control-Allow-Origin "*" env=CORS_ALLOWED
  Header always set Cross-Origin-Resource-Policy "cross-origin" env=CORS_ALLOWED

  # جلوگیری از Hotlink مستقیم در HTML (X-Frame-Options)
  # اگه ویدیوها در iframe استفاده می‌شوند، این راcomment کنید
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# ---------------------------------------------------------------------------
# ⚠️ توجه مهم: تست‌های واقعی نشان داد dll.mrdastbaaf.com از Caddy استفاده
# می‌کند (header: `via: 1.1 Caddy`، `server: BitNinja-WafPro`). یعنی این
# فایل .htaccess روی dll.mrdastbaaf.com کار نخواهد کرد — مگر اینکه پشت
# BitNinja یک Apache/cPanel باشد که .htaccess را پردازش کند.
#
# برای Caddy، معادل directive در پایین فایل آمده است.
# ===========================================================================

# ---------------------------------------------------------------------------
# کش هوشمند — فایل‌های ویدیویی cache-busting با hash ندارند، پس باید
# فقط با revalidate کش شوند (نه max-age طولانی)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webm|ogg|mov|m4v)$">
    Header set Cache-Control "private, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ===========================================================================
# معادل Caddy (اگه dll.mrdastbaaf.com با Caddy سرو می‌شود)
# ---------------------------------------------------------------------------
# این بلوک را در Caddyfile خود اضافه کنید (نه در .htaccess):
#
#   dll.mrdastbaaf.com {
#       @video {
#           path *.mp4 *.webm *.ogg *.mov *.m4v *.m3u8 *.ts
#       }
#       @allowedReferer {
#           header_regexp Referer ^https?://([a-z0-9-]+\.)?mrdastbaaf\.com/
#       }
#       @noReferer {
#           header Referer ^$
#       }
#       @searchEngine {
#           header_regexp Referer (google|bing|yandex)
#       }
#
#       # درخواست‌های مجاز (Referer درست یا خالی یا موتور جستجو) → اجازه
#       handle @video {
#           # نکته: ترتیب مهم است — اگه یکی از این conditions درست باشد، اجازه
#           handle @allowedReferer {
#               header Access-Control-Allow-Origin "*"
#               file_server
#           }
#           handle @noReferer {
#               file_server
#           }
#           handle @searchEngine {
#               file_server
#           }
#           # در غیر این صورت → 403
#           respond 403
#       }
#
#       # سایر درخواست‌ها (HTML, CSS, JS, تصاویر)
#       handle {
#           file_server
#       }
#   }
#
# ---------------------------------------------------------------------------
# برای تست: این بلوک را اعمال کنید و سپس:
#   curl -I https://dll.mrdastbaaf.com/.../video.mp4
# باید 403 بدهد. و درخواست با Referer درست باید 200 بدهد.
# ===========================================================================
