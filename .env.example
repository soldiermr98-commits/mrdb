# ---------------------------------------------------------------------------
# مستر دستباف PWA — نمونهٔ فایل environment (v1.1.0)
# این فایل را به «.env.local» (یا .env) کپی کنید و مقادیر را تنظیم کنید.
#
# حالت Dual-Mode:
#   - اگر VITE_API_BASE_URL خالی/تنظیم‌نشده باشد → اپ در «حالت دمو» با داده‌های mock اجرا می‌شود
#     (دقیقاً مثل نسخه‌های قبلی؛ هیچ درخواست شبکه‌ای به سرور زده نمی‌شود).
#   - اگر مقدار داشته باشد → «حالت Real-API» فعال می‌شود و سرویس‌ها به پل وردپرس وصل می‌شوند.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ⚠️ مهم — گارد بیلد پروداکشن (prelive 18-b):
#   VITE_API_BASE_URL برای «بیلد پروداکشن» الزامی است؛ بدون این متغیر (یا با
#   مقدار غیر https) دستور `npm run build` با خطای فارسی زیر متوقف می‌شود:
#     «بیلد پروداکشن بدون VITE_API_BASE_URL معتبر (https) مجاز نیست —
#      برای بیلد دمو از dev استفاده کنید یا متغیر را در .env.production ست کنید.»
#   فرمت صحیح (بدون اسلش انتهایی):
#     https://mrdastbaaf.com/wp-json/mrdastbaaf/v1
#   حالت دمو فقط با `npm run dev` اجرا می‌شود — هیچ کلید/دریچهٔ فرار (escape
#   hatch) دیگری برای دور زدن این گارد وجود ندارد (VITE_ALLOW_* تعریف نشده است).
# ---------------------------------------------------------------------------

# آدرس پایهٔ REST API پل وردپرس «مستر دستباف» (بدون اسلش انتهایی) — برای بیلد پروداکشن الزامی
VITE_API_BASE_URL=https://mrdastbaaf.com/wp-json/mrdastbaaf/v1

# ---------------------------------------------------------------------------
# متغیرهای قدیمی قالب (سازندهٔ اولیه) — در نسخهٔ فعلی PWA استفاده نمی‌شوند
# ---------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
